generator client {

  provider = "prisma-client-js"

}



datasource db {

  provider = "postgresql"

  url      = env("DATABASE_URL")

}



enum Role {

  admin

  contributor

  viewer

  moderator

}



enum Gender {

  Male

  Female

}



model User {

  id            Int       @id @default(autoincrement())

  full_name     String    @db.VarChar(255)

  email         String    @unique @db.VarChar(255)

  password_hash String    @db.VarChar(255)

  phone         String?   @db.VarChar(50)

  bio           String?   @db.Text

  role          Role      @default(viewer)

  reset_code    String?   @db.VarChar(10)

  reset_expires DateTime?

  created_at    DateTime  @default(now())

  updated_at    DateTime  @updatedAt



  individuals Individual[]

  marriages   Marriage[]

  auditLogs   AuditLog[]

}



model Clan {

  id          Int          @id @default(autoincrement())

  name        String       @unique @db.VarChar(255)

  totem       String?      @db.VarChar(255)

  head_title  String?      @db.VarChar(255)

  description String?      @db.Text

  created_at  DateTime     @default(now())

  individuals Individual[]

}



model Individual {

  id               Int       @id @default(autoincrement())

  full_name        String    @db.VarChar(255)

  gender           Gender

  clan_id          Int?

  father_id        Int?

  mother_id        Int?

  spouse_id        Int?

  bio              String?   @db.Text

  date_of_birth    DateTime? @db.Date

  date_of_death    DateTime? @db.Date

  occupation       String?   @db.VarChar(255)

  residence        String?   @db.VarChar(255)

  alternative_name String?   @db.VarChar(255)

  photo_url        String?   @db.VarChar(500)

  is_external      Boolean   @default(false)

  user_id          Int

  created_at       DateTime  @default(now())

  updated_at       DateTime  @updatedAt



  user             User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  clan             Clan?        @relation(fields: [clan_id], references: [id], onDelete: SetNull)

  father           Individual?  @relation("FatherChildren", fields: [father_id], references: [id], onDelete: SetNull)

  childrenAsFather Individual[] @relation("FatherChildren")

  mother           Individual?  @relation("MotherChildren", fields: [mother_id], references: [id], onDelete: SetNull)

  childrenAsMother Individual[] @relation("MotherChildren")

  spouse           Individual?  @relation("SpouseLink", fields: [spouse_id], references: [id], onDelete: SetNull)

  spouseOf         Individual[] @relation("SpouseLink")



  marriagesAsHusband Marriage[] @relation("Husband")

  marriagesAsWife    Marriage[] @relation("Wife")



  @@index([user_id])

  @@index([father_id])

  @@index([mother_id])

}



model Marriage {

  id            Int       @id @default(autoincrement())

  husband_id    Int?

  wife_id       Int?

  marriage_date DateTime? @db.Date

  location      String?   @db.VarChar(255)

  notes         String?   @db.Text

  user_id       Int

  created_at    DateTime  @default(now())



  husband Individual? @relation("Husband", fields: [husband_id], references: [id], onDelete: SetNull)

  wife    Individual? @relation("Wife", fields: [wife_id], references: [id], onDelete: SetNull)

  user    User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

}



model RoleDefinition {

  id          Int              @id @default(autoincrement())

  name        String           @unique @db.VarChar(50)

  description String?          @db.Text

  created_at  DateTime         @default(now())

  permissions RolePermission[]

}



model Permission {

  id          Int              @id @default(autoincrement())

  name        String           @unique @db.VarChar(100)

  description String?          @db.Text

  created_at  DateTime         @default(now())

  roles       RolePermission[]

}



model RolePermission {

  id            Int            @id @default(autoincrement())

  role_id       Int

  permission_id Int

  role          RoleDefinition @relation(fields: [role_id], references: [id], onDelete: Cascade)

  permission    Permission     @relation(fields: [permission_id], references: [id], onDelete: Cascade)



  @@unique([role_id, permission_id])

}



model AuditLog {

  id          Int      @id @default(autoincrement())

  user_id     Int

  action      String   @db.VarChar(100)

  entity_type String?  @db.VarChar(50)

  entity_id   Int?

  changes     Json?

  created_at  DateTime @default(now())



  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)



  @@index([user_id])

  @@index([entity_type, entity_id])

}


