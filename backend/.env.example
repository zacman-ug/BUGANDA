# Server
PORT=5000
NODE_ENV=development

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/buganda_heritage

# Auth — REQUIRED in production (server will fail to start without a strong secret)
JWT_SECRET=change-me-to-a-long-random-string

# Email (password reset)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Uploaded photos are stored in backend/uploads/ (created automatically)
